# 본선용 예시. 값은 운영자가 별도 보관하고 실행 승인 뒤 채웁니다.
# 기본 차단을 유지합니다. 실행 승인 토큰은 이 파일에 미리 넣지 않습니다.
PUBLIC_DEPLOYMENT=false
DEMO_MODE=false
