TRUST_BUNDLE_FILENAME=trust-bundle.json
CALLSIGN_APP_IMAGE=
CALLSIGN_WEB_IMAGE=
TURN_IMAGE=
PLATFORM_INTERNAL_TOKEN=
SENDER_INTERNAL_TOKEN=
MIGRATOR_DB_PASSWORD=
ISSUER_DATABASE_URL=
AUTH_DATABASE_URL=
TURN_URLS=
TURN_SECRET=
OIDC_ISSUER=
OIDC_JWKS_URL=
OIDC_AUTHORIZATION_URL=
OIDC_TOKEN_URL=
OIDC_CLIENT_ID=
OFFICIAL_OIDC_CLIENT_ID=
OIDC_AUDIENCE=
OFFICIAL_OIDC_AUDIENCE=
