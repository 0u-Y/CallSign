# 서비스 배포 예시. 값은 운영자가 별도 보관하고 실행 승인 뒤 채웁니다.
# 기본 차단을 유지합니다. 실행 승인 토큰은 이 파일에 미리 넣지 않습니다.
PUBLIC_DEPLOYMENT=false
DEMO_MODE=false
WEB_ORIGIN=http://localhost:8080
CALLSIGN_DOMAIN=
INSTITUTION_ID=mock-bank-institution-0001
NETWORK_ID=20260914
REGISTRY_ADDRESS=
# 선택 호환 경로에서만 SERVICE_DID를 사용합니다. 기본은 SERVICE_URI입니다.
SERVICE_DID=
FINALS_DATA_DIR=/srv/callsign
TRUST_BUNDLE_FILENAME=trust-bundle.json
CALLSIGN_APP_IMAGE=
CALLSIGN_WEB_IMAGE=
TURN_IMAGE=
PLATFORM_INTERNAL_TOKEN=
SENDER_INTERNAL_TOKEN=
MIGRATOR_DB_PASSWORD=
ISSUER_DATABASE_URL=
AUTH_DATABASE_URL=
TURN_URLS=
TURN_SECRET=
OIDC_ISSUER=
OIDC_JWKS_URL=
OIDC_AUTHORIZATION_URL=
OIDC_TOKEN_URL=
OIDC_CLIENT_ID=
OFFICIAL_OIDC_CLIENT_ID=
OIDC_AUDIENCE=
OFFICIAL_OIDC_AUDIENCE=
REGISTRY_APPROVERS=
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
VITE_PROTOCOL_PROFILE=service
VITE_FINALS_TRUST_SHA256=
# v1 로컬 회귀 전용; 본선은 finals-server를 사용합니다.
# OLLAMA_MODEL이 비어 있으면 로컬 모델 추론을 호출하지 않습니다.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=

# URI profile, policy defaults (not established service limits or measured SLAs).
ISSUER_URI=https://bank.example.invalid
SERVICE_URI=https://center.example.invalid
VITE_SERVICE_TRUST_SHA256=
CALL_LEASE_SECONDS=30
CALL_MAX_SECONDS=14400
ARI_URL=https://asterisk:8089
ARI_AUTHORIZATION=
PBX_EVIDENCE_KEY_PATH=
PBX_DTLS_CERT_PATH=
PBX_CREDENTIAL_SECRET=
SIP_REALM=
SIP_DOMAIN=
SIP_WSS_URL=wss://callsign.example.invalid/pbx/ws
WORKER_DATABASE_URL=
DEPLOYMENT_ID=
CONSUMPTION_ANCHOR_URL=
CONSUMPTION_ANCHOR_TOKEN=

# Explicit provisioning and maintenance inputs; no keys or passwords are supplied here.
SENDER_KEY_FILENAME=key.json
EXPECTED_GENESIS_HASH=
DEPLOYER_KEY_PATH=
REGISTRY_ARTIFACT_PATH=artifacts/service-registry-build-20261027.json
REGISTRY_ARTIFACT_SHA256=44106b7087d542431cee1264df10d2c50d255e90ef36916090cb27db54753b23
PBX_PUBLIC_HOST=
PBX_PUBLIC_ADDRESS=
ARI_PASSWORD=
PBX_DB_USER=
PBX_DB_PASSWORD=
BACKUP_ENCRYPTION_KEY_PATH=
BACKUP_CONFIRMATION=
CHAIN_SNAPSHOT_ARCHIVE=
BACKUP_DIR=
RESTORE_BUNDLE=
RESTORE_DATA_DIR=
RESTORE_DATABASE_URL=
RESTORE_CONFIRMATION=

PBX_PRIVATE_ADDRESS=10.205.0.20

# Protected external environment file included only in explicitly approved encrypted backup.
BACKUP_DEPLOYMENT_ENV_PATH=
# Offline release manifest: input evidence must identify the same clean Git commit.
RELEASE_EVIDENCE_PATH=

# Per authenticated user across replicas; supports the 1-second call observation path.
API_REQUESTS_PER_MINUTE=600

# Explicit one-off operations profile; never started by normal deployment.sh.
FINALS_ACCOUNTS_PATH=
DEPLOYMENT_WORK_DIR=
MIGRATOR_DATABASE_URL=
ASTERISK_IMAGE=

# Explicit validation profile: a separate disposable DB, never the live deployment DB.
TEST_DATABASE_URL=
TEST_AUTH_DATABASE_URL=

# Jointly confirmed business-policy version; rebuild and pin trust after a policy change.
SERVICE_POLICY_VERSION=1

# Role LOGIN provisioning uses only a protected process environment after explicit approval.
# These are not input values to send in chat; migration/role setup is not run by preflight.
ISSUER_DB_PASSWORD=
AUTH_DB_PASSWORD=
WORKER_DB_PASSWORD=
# Set PBX_DB_USER=callsign_pbx_login only after reviewed LOGIN provisioning.
# Validation always targets a separate callsign_test_* database; never reuse live URLs.
VALIDATION_DEPLOYMENT_PATH=
VALIDATION_TRUST_PATH=
VALIDATION_RELEASE_MANIFEST=
VALIDATION_MEASUREMENTS_PATH=

# Actual reviewed infrastructure image digests; tags in Compose are bootstrap compatibility defaults only.
BESU_IMAGE=
POSTGRES_IMAGE=
HTTPS_IMAGE=

# New key versions and a NEW public manifest are explicit rotation inputs, never ordinary restart actions.
APPROVAL_KEY_VERSION=1
SERVICE_KEY_VERSION=1
PUBLIC_MANIFEST_PATH=

# Optional role-path overrides; preflight derives these from FINALS_DATA_DIR when omitted.
ISSUER_APPROVAL_KEY_PATH=
SENDER_PRIVATE_KEY_PATH=
WITNESS_1_KEY_PATH=
WITNESS_2_KEY_PATH=
WITNESS_3_KEY_PATH=
WITNESS_4_KEY_PATH=
