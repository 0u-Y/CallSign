{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/v3/audio",
      "destination": "/api/audio"
    },
    {
      "source": "/api/v3/:path*",
      "destination": "https://callsign-demo-l-fixed.tail37b235.ts.net/api/v3/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:; media-src 'self' blob:; connect-src 'self' wss://callsign-demo-l-fixed.tail37b235.ts.net; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(self), geolocation=()"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "framework": "vite",
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "VITE_PUBLIC_PREVIEW=${VITE_PUBLIC_PREVIEW:-true} pnpm --filter @callsign/web build",
  "outputDirectory": "apps/web/dist",
  "redirects": [
    {
      "source": "/legacy/demo",
      "destination": "/service",
      "permanent": false
    }
  ]
}
