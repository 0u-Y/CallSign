# Public TLS ends at the owned Funnel; only its loopback TCP connection reaches coturn.
listening-ip=127.0.0.1
listening-port=13478
relay-ip=@PBX_PRIVATE_ADDRESS@
min-port=49160
max-port=49200
fingerprint
use-auth-secret
static-auth-secret=@TURN_SECRET@
realm=@SIP_REALM@
no-udp
no-tls
no-dtls
no-tcp-relay
no-cli
no-multicast-peers
allow-loopback-peers=0
denied-peer-ip=0.0.0.0-255.255.255.255
allowed-peer-ip=@PBX_PRIVATE_ADDRESS@
user-quota=4
total-quota=16
relay-threads=1
pidfile=/tmp/turn.pid
log-file=stdout
simple-log
