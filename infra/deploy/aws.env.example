# Public AWS deployment contract. Copy to a protected file; fill secret VALUES there or via operator environment.
# Never source this file as shell. No AWS resources are created by this template.
# Canonical input classes/consumers/order: docs/RUNBOOK.md#aws-input-contract
# Blank values BLOCK their first required phase. Reserved .example/.invalid/.test hosts are rejected.
# Generated image/contract/trust metadata is output, never invented operator input.
CALLSIGN_DEPLOYMENT_TARGET=aws
AWS_DEPLOYMENT_MODE=new
PUBLIC_DEPLOYMENT=true
DEMO_MODE=false
CALLSIGN_PROJECT=
DEPLOYMENT_ID=
INSTITUTION_ID=
NETWORK_ID=
ISSUER_URI=
SERVICE_URI=
AWS_RELEASE_DIR=/srv/callsign-release
FINALS_DATA_DIR=/srv/callsign/config
AWS_VOLUME_ROOT=/srv/callsign/volumes
AWS_WEB_TLS_DIR=/srv/callsign/tls/web
SERVICE_EXTRA_CA_PATH=/srv/callsign/tls/service-ca.pem
FINALS_ACCOUNTS_PATH=/srv/callsign/protected/accounts.json
# AWS VPC/subnet must be reviewed against both Docker CIDRs; these are proposals only.
LEDGER_IPV4_PREFIX=10.206.0
PBX_PRIVATE_ADDRESS=10.205.0.20
TURN_PRIVATE_ADDRESS=10.205.0.30
CALLSIGN_DOMAIN=
WEB_ORIGIN=
PBX_PUBLIC_HOST=
PBX_PUBLIC_ADDRESS=
SIP_DOMAIN=
SIP_REALM=
SIP_WSS_URL=
TURN_URLS=
OIDC_ISSUER=
OIDC_JWKS_URL=
OIDC_AUTHORIZATION_URL=
OIDC_TOKEN_URL=
OIDC_CLIENT_ID=
OFFICIAL_OIDC_CLIENT_ID=
OIDC_AUDIENCE=
OFFICIAL_OIDC_AUDIENCE=
# Public developer endpoints to forbid in runtime URLs, comma-separated. Do not include credentials.
CALLSIGN_FORBIDDEN_HOSTS=
CONSUMPTION_ANCHOR_URL=
CALLSIGN_APP_IMAGE=
CALLSIGN_WEB_IMAGE=
BESU_IMAGE=
POSTGRES_IMAGE=
ASTERISK_IMAGE=
TURN_IMAGE=
HTTPS_IMAGE=
# Generated from actual deployment/public keys/PBX certificate; final web comes afterwards.
VITE_SERVICE_TRUST_SHA256=
VITE_PROTOCOL_PROFILE=service
SERVICE_POLICY_VERSION=1
CALL_LEASE_SECONDS=30
CALL_MAX_SECONDS=14400
RETENTION_SECONDS=604800
# Generated after actual contract deployment; not required to create NEW keys.
REGISTRY_ADDRESS=
REGISTRY_APPROVERS=
DEPLOYER_PUBLIC_ADDRESS=
REGISTRY_ADMIN_ADDRESS=
REGISTRY_OPERATOR_ADDRESS=
EXPECTED_GENESIS_HASH=
REGISTRY_ARTIFACT_PATH=/srv/callsign-release/artifacts/service-registry-build-20261027.json
REGISTRY_ARTIFACT_SHA256=
DEPLOYMENT_WORK_DIR=/srv/callsign/config
DEPLOYER_KEY_PATH=/srv/callsign/config/deployer/key.txt
ARI_URL=https://asterisk:8089
# Protected values below: keep separate issuer/auth/worker/PBX LOGINs; never commit filled files.
MIGRATOR_DB_PASSWORD=
ISSUER_DB_PASSWORD=
AUTH_DB_PASSWORD=
WORKER_DB_PASSWORD=
MIGRATOR_DATABASE_URL=
ISSUER_DATABASE_URL=
AUTH_DATABASE_URL=
WORKER_DATABASE_URL=
PBX_DB_USER=callsign_pbx_login
PBX_DB_PASSWORD=
PLATFORM_INTERNAL_TOKEN=
SENDER_INTERNAL_TOKEN=
CONSUMPTION_ANCHOR_TOKEN=
TURN_SECRET=
PBX_CREDENTIAL_SECRET=
ARI_PASSWORD=
ARI_AUTHORIZATION=
# Optional AI: absent credentials mean unavailable analysis, never a safe verdict.
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Explicit server-side provider selection; file refs are never VITE variables or secret values.
CALLSIGN_PROVIDER_CONFIG=none
CALLSIGN_ANALYSIS_PROVIDER=disabled
OPENAI_MODEL=
OPENAI_API_KEY_FILE=
DEEPGRAM_API_KEY_FILE=

# Optional real IdP; initialization is separate from normal start/restart.
CALLSIGN_OIDC_PROVIDER=external
KEYCLOAK_IMAGE=
KEYCLOAK_PUBLIC_ORIGIN=
KEYCLOAK_HTTP_PATH=/idp
KEYCLOAK_TRUSTED_PROXY_CIDRS=
KEYCLOAK_ENV_FILE=
KEYCLOAK_DB_PASSWORD_FILE=
KEYCLOAK_REALM_IMPORT_FILE=
