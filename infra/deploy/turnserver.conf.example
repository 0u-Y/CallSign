listening-port=3478
tls-listening-port=5349
fingerprint
use-auth-secret
# Render the following through the operator secret store. Never commit the result.
static-auth-secret=@TURN_SECRET@
realm=@SIP_REALM@
listening-ip=@TURN_PRIVATE_ADDRESS@
relay-ip=@TURN_PRIVATE_ADDRESS@
external-ip=@PBX_PUBLIC_ADDRESS@/@TURN_PRIVATE_ADDRESS@
min-port=49160
max-port=49200
no-cli
no-multicast-peers
allow-loopback-peers=0
no-tcp-relay
denied-peer-ip=169.254.0.0-169.254.255.255
cert=/etc/coturn/tls/fullchain.pem
pkey=/etc/coturn/tls/privkey.pem
