listening-port=3478
tls-listening-port=5349
fingerprint
use-auth-secret
# Render the following through the operator secret store. Never commit the result.
static-auth-secret=RENDER_FROM_TURN_SECRET
realm=turn.example.invalid
external-ip=RENDER_VM_PUBLIC_IP
min-port=49160
max-port=49200
no-cli
no-multicast-peers
no-loopback-peers
no-tcp-relay
cert=/etc/coturn/tls/fullchain.pem
pkey=/etc/coturn/tls/privkey.pem
